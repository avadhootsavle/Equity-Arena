# Equity Arena Backend Environment Variables Configuration

# Server Port (Assigned dynamically by Render in production, default: 5001)
PORT=5001

# PostgreSQL Database Connection URL (Render PostgreSQL or local)
DATABASE_URL="postgresql://user:password@localhost:5432/stockgame?schema=public"

# JWT Authentication Secret Key
JWT_SECRET="equity_arena_super_secret_jwt_key_2026"

# Frontend Origin Client URL (Allowed CORS domain, e.g. Vercel deployment URL)
CLIENT_URL="http://localhost:5173"

# ==============================================================================
# Equity Arena — Backend Environment Variables Configuration
# ==============================================================================

# Server Port (Render sets this dynamically in production; default local is 5001)
PORT=5001

# PostgreSQL Database Connection URL
# Local Example: postgresql://user:password@localhost:5432/stockgame?schema=public
# Render PostgreSQL Example: postgresql://equity_user:secret@dpg-xxxxx.singapore-postgres.render.com/equity_arena
DATABASE_URL="postgresql://user:password@localhost:5432/stockgame?schema=public"

# JWT Authentication Secret Key (Generate a random 64-char string for production)
JWT_SECRET="equity_arena_super_secret_jwt_key_2026_production"

# Frontend Origin Client URL (Allowed CORS domain, e.g. https://equity-arena.vercel.app or local)
# Set to your Vercel deployment URL in production. The backend dynamically permits matching origins.
CLIENT_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"

# ======================================================================
# EQUITY ARENA BACKEND — CLOUD PRODUCTION (RENDER) ENVIRONMENT CONFIGURATION
# Set these key-value pairs in your Render Web Service Environment Variables
# ======================================================================

# Render Internal PostgreSQL Database URL (Internal database URL for fastest speed)
DATABASE_URL="postgresql://equity_arena_db_user:password@dpg-xxxx-a/equity_arena_db"

# JWT Secret Key for authenticating production trader and admin sessions
JWT_SECRET="equity_arena_super_secret_jwt_key_2026_production"

# Environment identifier
NODE_ENV="production"

# Port assigned dynamically by Render (or default 5001)
PORT=5001

# Allowed Client Origin — Set to your live Vercel production frontend URL
CLIENT_URL="https://equity-arena.vercel.app"

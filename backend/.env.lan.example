# ======================================================================
# EQUITY ARENA BACKEND — LOCAL LAB LAN MODE ENVIRONMENT CONFIGURATION
# Copy this file to `backend/.env` for local college lab WiFi events
# ======================================================================

# Local PostgreSQL database connection URL (Embedded or Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockgame?schema=public"

# JWT Secret Key for authenticating trader and admin sessions
JWT_SECRET="super-secret-stockgame-jwt-key-2026"

# Port on which the backend server listens
PORT=5001

# Allowed Client Origin(s) — Replace 192.168.x.x with your laptop's actual LAN IP
# You can provide a comma-separated list of origins e.g. http://192.168.1.42:5173,http://localhost:5173
CLIENT_URL="http://192.168.x.x:5173,http://localhost:5173"
